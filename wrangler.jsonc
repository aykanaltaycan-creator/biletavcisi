{
  // Bilet Avcısı - Cloudflare Worker ayarları
  "name": "biletavcisi",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  // Loglama açık: Observability > Events ekranında çalışmaları görebilmek için
  "observability": {
    "enabled": true
  },
  // Panelden eklenen değişkenler (TP_TOKEN, TG_BOT_TOKEN gibi Secret'lar) her yayında silinmesin
  "keep_vars": true,
  // Gizli olmayan değişkenler
  "vars": {
    "TP_MARKER": "779049",
    "TG_CHAT": "@biletavcisinet"
  },
  // Günde iki kez çalışır: 08:00 ve 18:00 (Türkiye saati)
  "triggers": {
    "crons": ["0 5 * * *", "0 15 * * *"]
  },
  // Fiyat hafızası: rota başına son ~45 günün fiyatını saklar.
  "kv_namespaces": [
    { "binding": "PRICE_HISTORY", "id": "a41b0096821041499d08ee0d1c85143a" }
  ]
}
